.hero-content > p:not(.tagline) { color: rgb(102, 107, 125); max-width: 500=
px; margin-bottom: 30px; }

.btn { display: inline-block; padding: 14px 25px; border-width: medium; bor=
der-style: none; border-color: currentcolor; border-image: none; border-rad=
ius: 8px; background: rgb(108, 77, 246); color: rgb(255, 255, 255); font-si=
