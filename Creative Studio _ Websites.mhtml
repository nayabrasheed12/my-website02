.card:hover { transform: translateY(-8px); box-shadow: rgba(25, 20, 70, 0.1=
2) 0px 15px 35px; }

.card-icon { font-size: 35px; color: rgb(108, 77, 246); margin-bottom: 15px=
; }

.card h3 { font-size: 21px; margin-bottom: 10px; }

.card p { color: rgb(112, 116, 135); }

.portfolio { text-align: center; }

.portfolio-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap=
: 25px; margin-top: 40px; text-align: left; }

.project { overflow: hidden; border-radius: 15px; background: white; box-sh=
adow: rgba(25, 20, 70, 0.08) 0px 8px 30px; transition: transform 0.3s; }

.project:hover { transform: translateY(-6px); }

.project img { width: 100%; height: 230px; object-fit: cover; transition: t=
ransform 0.4s; }

.project:hover img { transform: scale(1.04); }

.project h3 { padding: 18px 18px 0px; font-size: 20px; }

.project p { padding: 0px 18px 20px; color: rgb(108, 77, 246); font-size: 1=
4px; }

.contact { background: rgb(248, 247, 255); text-align: center; }

.contact > p:not(.tagline) { color: rgb(102, 107, 125); margin-bottom: 15px=
; }

