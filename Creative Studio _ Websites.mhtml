.btn:hover { background: rgb(80, 52, 213); transform: translateY(-3px); }

.hero-image { flex: 1 1 0%; }

.hero-image img { width: 100%; height: 400px; object-fit: cover; border-rad=
ius: 25px; box-shadow: rgba(46, 35, 110, 0.15) 0px 20px 50px; }

.about { max-width: 900px; margin: auto; text-align: center; }

.about > p:last-child { max-width: 700px; margin: 0px auto; color: rgb(102,=
 107, 125); }

.services { background: rgb(248, 247, 255); text-align: center; }

.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; m=
argin-top: 40px; text-align: left; }

.card { background: rgb(255, 255, 255); padding: 35px 28px; border-radius: =
16px; box-shadow: rgba(25, 20, 70, 0.06) 0px 8px 30px; border: 1px solid rg=
